{
  "name": "lifescore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "// node": "Needs --env-file-if-exists (20.6+) and node:sqlite for the SQLite import (22+). Built and tested on 24.",
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "node --experimental-strip-types --env-file-if-exists=.env --import ./tests/register.mjs scripts/seed.ts",
    "test": "node --experimental-strip-types --import ./tests/register.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "node --experimental-strip-types --env-file-if-exists=.env --import ./tests/register.mjs scripts/import-sqlite.ts",
    "check:llm": "node --experimental-strip-types --env-file-if-exists=.env --import ./tests/register.mjs scripts/check-llm.ts",
    "reset": "node --experimental-strip-types --env-file-if-exists=.env --import ./tests/register.mjs scripts/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
