# Copy to .env and fill in. Never commit the filled-in file — .env is gitignored.

# Postgres connection string. Required in production.
# Leave it blank locally and the app runs an in-process Postgres (PGlite) with
# its data under ./data/pgdata — no database server to install.
# Free managed options: https://neon.tech or https://supabase.com
DATABASE_URL=

# Optional. Without it the app still works: the deterministic resolver handles
# exact/alias/keyword/similarity matches, and anything it can't resolve asks the
# user to pick the activity instead of guessing.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional override. Defaults to openai/gpt-oss-120b. Must support tool calling.
# Providers retire model ids without notice and the app degrades silently when
# that happens, so check it with:  npm run check:llm
GROQ_MODEL=
